{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=ErpDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "erp-api",
    "Audience": "erp-web",
    "SigningKey": "CHANGE_ME__please_use_a_long_random_secret_of_at_least_32_bytes",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": [ "http://localhost:8080", "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
